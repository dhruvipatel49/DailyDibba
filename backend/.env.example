# Copy to .env and fill in
NODE_ENV=development
PORT=5000

# NeonDB / any PostgreSQL connection string (Neon needs ?sslmode=require)
DATABASE_URL=postgresql://user:password@host/dailydibba?sslmode=require

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Money (whole rupees)
DELIVERY_FEE=40
PICKUP_FEE=50

# Timezone used for "pickup date can't be in the past"
APP_TZ=Asia/Kolkata

# Created/updated by `npm run seed`
ADMIN_EMAIL=admin@dailydibba.local
ADMIN_PASSWORD=ChangeThisAdminPassword1
